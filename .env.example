# Copy this to `.env` and fill in your own values. `.env` is gitignored.
#
# Nothing in this repository prints, logs or commits these. The access token is written
# to data/kite_access_token.json, which is also gitignored, and is rotated by Kite every
# morning around 6am IST.

# From developers.kite.trade after you create the app.
KITE_API_KEY=
KITE_API_SECRET=

# Leave blank. `fb kite login` fetches today's token and saves it for you; set this only
# if you want to supply a token from elsewhere.
KITE_ACCESS_TOKEN=

# Optional: keep large model caches off the C: drive.
# HF_HOME=D:/ai-cache/hf
# HF_HUB_DISABLE_SYMLINKS=1
