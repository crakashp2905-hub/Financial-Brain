{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-brain.local/schemas/instrument-master.v1.schema.json",
  "title": "Financial Brain source-aware instrument master v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "records", "adjustments", "sha256"],
  "properties": {
    "schema": {"const": "fb.instrument_master.v1"},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}},
    "adjustments": {"type": "array", "items": {"$ref": "#/$defs/adjustment"}},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_id", "kind", "source_id", "source_token", "exchange", "segment", "trading_symbol", "effective_from", "effective_through", "source_published_at", "received_at", "source_payload_sha256", "lot_size", "tick_size", "underlying_id", "isin", "expiry", "strike", "right", "adjustment_factor"],
      "properties": {
        "canonical_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["EQUITY", "ETF", "INDEX", "FUTURE", "OPTION"]},
        "source_id": {"type": "string", "minLength": 1},
        "source_token": {"type": "string", "minLength": 1},
        "exchange": {"type": "string", "minLength": 1},
        "segment": {"type": "string", "minLength": 1},
        "trading_symbol": {"type": "string", "minLength": 1},
        "effective_from": {"type": "string", "format": "date"},
        "effective_through": {"type": ["string", "null"], "format": "date"},
        "source_published_at": {"type": "string", "format": "date-time"},
        "received_at": {"type": "string", "format": "date-time"},
        "source_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lot_size": {"type": "integer", "minimum": 1},
        "tick_size": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
        "underlying_id": {"type": ["string", "null"]},
        "isin": {"type": ["string", "null"]},
        "expiry": {"type": ["string", "null"], "format": "date"},
        "strike": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+)?$"},
        "right": {"enum": ["CE", "PE", null]},
        "adjustment_factor": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"}
      }
    },
    "adjustment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_id", "action_id", "action_type", "effective_on", "price_factor", "volume_factor", "source_id", "source_published_at", "received_at", "source_payload_sha256"],
      "properties": {
        "canonical_id": {"type": "string", "minLength": 1},
        "action_id": {"type": "string", "minLength": 1},
        "action_type": {"type": "string", "minLength": 1},
        "effective_on": {"type": "string", "format": "date"},
        "price_factor": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
        "volume_factor": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
        "source_id": {"type": "string", "minLength": 1},
        "source_published_at": {"type": "string", "format": "date-time"},
        "received_at": {"type": "string", "format": "date-time"},
        "source_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
